#!/bin/sh

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/kanshi/config"

# still looll but you should check what was here before
profiles=$(awk '$1 == "profile" && $2 != "{" { sub(/\{$/, "", $2); print $2 }' "$CONFIG")

[ -n "$profiles" ] || exit 1

if [ "$1" = "--list" ]; then
    printf '%s\n' "$profiles"
    exit 0
fi

if [ -n "$1" ]; then
    exec kanshictl switch "$1"
fi

selected=$(printf '%s\n' "$profiles" | rofi -dmenu -i -no-custom -p "display" \
    -theme gruvbox-dark-hard)
[ -n "$selected" ] || exit 0

exec kanshictl switch "$selected"

#!/bin/sh

# Respect blocking sleep inhibitors while unlocked; locked displays may turn off.
# Delay inhibitors (such as swayidle's before-sleep hook) do not block this.
blocked=$(busctl --system get-property \
    org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager BlockInhibited | cut -d '"' -f 2)

case ":$blocked:" in
    *:sleep:*)
        if pgrep -u "$(id -u)" -x swaylock >/dev/null; then
            exec niri msg action power-off-monitors
        fi
        exit 0
        ;;
esac

swaylock -f
niri msg action power-off-monitors
